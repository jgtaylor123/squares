rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /entries/{entryId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Grid year configurations and reservations
    match /grids/{yearId} {
      function isSuperAdmin() {
        return request.auth != null && request.auth.token.superAdmin == true;
      }

      function isBoardOwner() {
        return request.auth != null
          && (resource.data.createdByUid == request.auth.uid
            || resource.data.createdBy == request.auth.token.email);
      }

      function isReservationOnlyUpdate() {
        return request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reservations', 'updatedAt']);
      }

      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.createdByUid == request.auth.uid;
      allow update: if isSuperAdmin() || isBoardOwner() || isReservationOnlyUpdate();
      allow delete: if isSuperAdmin() || isBoardOwner();
    }

    // User directory for mapping uid -> email/displayName
    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Short code mappings for board IDs
    match /shortCodes/{code} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }
  }
}
